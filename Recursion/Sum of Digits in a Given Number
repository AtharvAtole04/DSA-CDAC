class Solution {
    public int addDigits(int num) {
        //your code goes here
        return recAddDigit(num);
    }

    public int recAddDigit(int num){
        if (num < 10) {
            return num;
        }

        int sum = 0;

        while (num > 0) {
            int element = num % 10;
            sum = sum + element;
            num = num / 10;
        }

        return recAddDigit(sum);
    }
}
