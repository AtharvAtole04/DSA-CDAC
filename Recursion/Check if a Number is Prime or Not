class Solution {
    public boolean checkPrime(int num) {
        //your code goes here
        return recCheckPrime(num,2);
    }

    public boolean recCheckPrime(int num,int n){

        if(num==1){
            return false;
        }

        if(n>num/2){
            return true;
        }
        if(num%n==0){
            return false;
        }
        return recCheckPrime(num,n+1);

    }
}
